# Copy this file to .env and fill in your real values from keys/private.md

# Database
DATABASE_PATH=./data/mynextpr.db

# Google OAuth (Required for user authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session Secret (Generate a random long string)
SESSION_SECRET=your_random_session_secret_here

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# URLs (update for your environment)
FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:3000
